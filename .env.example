# Copy this file to .env and edit the values you need to override.
#   cp .env.example .env
#
# Every variable here uses ${VAR:-default} in the compose files, so an
# unset / missing .env keeps today's defaults intact.

# ─── Host port mappings ───────────────────────────────────────────────────────
# RPC + Engine API ports for whichever Ethereum client is running. Only one
# client runs at a time, so a single pair covers nethermind/geth/besu/reth/erigon
# and the test-client (Geth --dev).
CLIENT_RPC_PORT=8545
CLIENT_ENGINE_PORT=8551

# Per-client metrics ports. These differ between clients because each client's
# default metrics port differs; the scrape configs in docker/prometheus*.yml
# are hardcoded to these values, so changing them here requires editing
# prometheus.yml / prometheus.test.yml in lock-step.
NETHERMIND_METRICS_PORT=6060
GETH_METRICS_PORT=6060
BESU_METRICS_PORT=9545
RETH_METRICS_PORT=9001
ERIGON_METRICS_PORT=6060
TEST_CLIENT_METRICS_PORT=6060

# Monitoring stack ports.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
CADVISOR_PORT=8080
NODE_EXPORTER_PORT=9100

# Locust Prometheus exporter — runs on the host (not in a container). The
# prometheus.yml / prometheus.test.yml scrape configs target host.docker.internal
# and host.orb.internal on this port; changing it requires editing those files too.
LOCUST_PROMETHEUS_PORT=9646

# ─── Image tags ───────────────────────────────────────────────────────────────
# Pin these to a specific tag for reproducible benchmarks; "latest" rolls.
NETHERMIND_IMAGE=nethermind/nethermind:latest
GETH_IMAGE=ethereum/client-go:latest
BESU_IMAGE=hyperledger/besu:latest
RETH_IMAGE=ghcr.io/paradigmxyz/reth:latest
ERIGON_IMAGE=erigontech/erigon:latest

PROMETHEUS_IMAGE=prom/prometheus:latest
GRAFANA_IMAGE=grafana/grafana:latest
NODE_EXPORTER_IMAGE=prom/node-exporter:latest
CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:v0.49.1

# ─── Grafana credentials ──────────────────────────────────────────────────────
# Default is admin/admin (anonymous viewer is also enabled by the compose env).
# Change these before exposing Grafana outside localhost.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ─── Docker socket override (cAdvisor on rootless Docker / OrbStack) ──────────
# Leave unset on Docker Desktop / rootful Linux. Set to /dev/null on rootless
# Docker so cAdvisor falls back to the systemd factory (see README for details).
# DOCKER_SOCK=/dev/null
