# Geth bloatnet benchmark environment.
# Loaded by start_infra.sh and run_benchmark.sh via `--env-file`.

# ---------------------------------------------------------------------------
# Network exposure
# ---------------------------------------------------------------------------
# 127.0.0.1 keeps all ports host-local. Set to 0.0.0.0 to expose Grafana /
# Prometheus / RPC outside the host (DO NOT do this on shared or public hosts:
# anonymous Grafana, default admin creds, open execution-client RPC).
BIND_ADDR=127.0.0.1

# ---------------------------------------------------------------------------
# Geth client
# ---------------------------------------------------------------------------
GETH_IMAGE=docker.ethquokkaops.io/dh/ethpandaops/geth:master-965bd6b
# Host path to the pre-synced snapshot datadir (chaindata under <dir>/geth/).
# Dir naming convention: <alias>-<label>-<block>-benchmark (run_snapshot_matrix.sh
# derives per-block dirs the same way). Must match overlay.lowerdir in
# templates/geth/config_geth.yml when the overlay is enabled. The engine-API JWT
# is NOT taken from the snapshot — it is mounted separately (GETH_JWT_PATH,
# default: the repo-tracked docker/jwtsecret).
GETH_DB_PATH=/mnt/bigdata/geth-x35-24358000-benchmark
GETH_NETWORK_ID=12159
GETH_LOG_VERBOSITY=3

# Avoid colliding with anything else on 8545/8551 on the host.
CLIENT_RPC_PORT=8549
CLIENT_WS_PORT=8548
CLIENT_ENGINE_PORT=8552
GETH_METRICS_PORT=6061

# ---------------------------------------------------------------------------
# Monitoring stack
# ---------------------------------------------------------------------------
PROMETHEUS_PORT=9092
GRAFANA_PORT=3001
NODE_EXPORTER_PORT=9101
CADVISOR_PORT=8081

# Set DOCKER_SOCK=/dev/null on rootless Docker (OrbStack etc.) so cAdvisor's
# broken docker factory is disabled and the systemd factory takes over.
# Leave unset on Docker Desktop / rootful Linux.
# DOCKER_SOCK=/dev/null

# Grafana admin (only matters if you actually log in; anonymous viewer is on).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
