# Snapshot manifest for run_snapshot_matrix.sh — one snapshot per line.
#   <snapshot_url> [payloads_file]
# The block is taken from the URL (.../<client>/<block>/snapshot.tar.zst).
# Payloads are PRE-STAGED per block; their first block must be <block>+1.
# If the payloads column is omitted, it defaults to PAYLOADS_PATTERN
#   (default: payloads_x35_<block>.jsonl, relative to the repo root).
#
# Copy this to snapshots.txt and edit. Lines beginning with # are ignored.

https://snapshots.ethpandaops.io/perf-devnet-3/geth/24358000/snapshot.tar.zst  payloads_x35_24358000.jsonl
