# Environment for the Nethermind x3.5 bloatnet template.
# Consumed by docker-compose.nethermind-bloatnet.yml, docker-compose.monitoring.yml,
# start_infra.sh and run_benchmark.sh (all invoked from the repo root).

# ---- Nethermind node ----
# Image MUST match the one that produced the snapshot's FlatDb state.
NETHERMIND_IMAGE=nethermindeth/nethermind:deep-states-turn
# x3.5 bloatnet snapshot DB (the `mainnet` subdir is the Nethermind db root).
# Dir naming convention: <alias>-<label>-<block>-benchmark (run_snapshot_matrix.sh
# derives per-block dirs the same way). Must match overlay.lowerdir in
# templates/nethermind/config_nethermind.yml when the overlay is enabled.
NETHERMIND_DB_PATH=/mnt/bigdata/neth-x35-24358000-benchmark/mainnet
# Bloatnet chainspec (mainnet shadowfork: chainId 1, p2p networkId 12159).
NETHERMIND_CHAINSPEC_PATH=/mnt/bigdata/cl-config/chainspec.json
# Engine-API JWT shared with the mock-CL replay. Defaults to the repo-tracked
# docker/jwtsecret. If you override it, use an ABSOLUTE path — docker compose
# and run_benchmark.sh resolve relative paths against different directories.
# NETHERMIND_JWT_PATH=/absolute/path/to/jwtsecret
NETHERMIND_LOG_LEVEL=INFO

# ---- Host port bindings ----
# Defaults dodge ports another node on the host may already own (8545 RPC /
# 8551 engine). RPC 8547 matches nodes.rpc_url in
# templates/nethermind/config_nethermind.yml — change both together.
BIND_ADDR=127.0.0.1
CLIENT_RPC_PORT=8547
CLIENT_ENGINE_PORT=8552
NETHERMIND_METRICS_PORT=6060

# ---- Monitoring stack (only used if start_infra.sh is run) ----
# Published off the stock 9090/3000/9100/8080 ports so the benchmark stack can
# coexist with any Prometheus / Grafana already running on the host.
# cAdvisor patched for the containerd-snapshotter image store (overlayfs) so
# per-container name="benchmark_*" series are emitted — see docker/cadvisor/Dockerfile
# and the README's cAdvisor note (build the image once before first use).
CADVISOR_IMAGE=cadvisor-layerdb-fix:v0.49.1
PROMETHEUS_PORT=9092
GRAFANA_PORT=3001
NODE_EXPORTER_PORT=9102
CADVISOR_PORT=8081

# ---- Mock-CL replay knobs (read by run_benchmark.sh) ----
# Payloads JSONL to replay (its first block must be the snapshot head + 1).
# If unset, run_benchmark.sh falls back to templates/nethermind/payloads/<milestone>.jsonl
# and skips replay with a warning when no file exists.
# MOCK_CL_PAYLOADS=payloads_x35_24358000.jsonl
MOCK_CL_JWT=docker/jwtsecret
MOCK_CL_ENGINE_URL=http://localhost:8552
