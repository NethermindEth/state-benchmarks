---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Card from '../components/ui/Card.astro';
import Stat from '../components/ui/Stat.astro';
import Detail from '../components/ui/Detail.astro';
import StateGrowthChart from '../components/charts/StateGrowthChart.tsx';
import CompositionChart from '../components/charts/CompositionChart.tsx';
import ProofComparisonChart from '../components/charts/ProofComparisonChart.tsx';
import ClientComparisonChart from '../components/charts/ClientComparisonChart.tsx';
import TrieDepthChart from '../components/charts/TrieDepthChart.tsx';
import SlotHistogramChart from '../components/charts/SlotHistogramChart.tsx';
import RpcLatencyChart from '../components/charts/RpcLatencyChart.tsx';
import AdvantageChart from '../components/charts/AdvantageChart.tsx';
import ScalingContrast from '../components/charts/ScalingContrast.tsx';
import ChartTakeaways from '../components/charts/ChartTakeaways.tsx';
import SummaryStatsChart from '../components/charts/SummaryStatsChart.tsx';
import growth from '../data/state-growth.json';
import proofs from '../data/proof-sizes.json';
import clients from '../data/client-comparison.json';
import snap from '../data/snap-sync.json';
import depth from '../data/trie-depth.json';
import slots from '../data/slot-histogram.json';
import stats from '../data/summary-stats.json';

const m1 = growth.milestones.find((m) => m.mult === 1)!;
const mx = growth.milestones.find((m) => m.mult === 10)!;
const fmtTB = (gb: number) => (gb >= 1000 ? `${(gb / 1000).toFixed(2)} TB` : `${Math.round(gb)} GB`);
const share = (part: number, total: number) => `${((part / total) * 100).toFixed(0)}%`;
---
<BaseLayout title="Results" description="Measured state-growth and composition data across all five milestones, 1× to 10×.">
  <Section
    eyebrow="Results"
    title="What we've measured."
    intro="All five milestones carry exact full-scan data — mainnet (1×, our reference), the inherited 3.5× Bloatnet starting state, and the 5× / 7× / 10× states we grew it to. The headline 10× target is reached. No projected numbers."
  >
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      <Stat measured value={fmtTB(mx.totalGB)} label="State at 10×" sub={`${(mx.totalGB / m1.totalGB).toFixed(2)}× mainnet`} />
      <Stat measured value={`${(mx.accounts / 1000).toFixed(2)}B`} label="Accounts at 10×" sub={`${m1.accounts}M at mainnet`} />
      <Stat measured value={`${(mx.storage / 1000).toFixed(2)}B`} label="Storage slots at 10×" sub={`${(m1.storage / 1000).toFixed(2)}B at mainnet`} />
      <Stat measured value={`${share(mx.storGB, mx.totalGB)}/${share(mx.acctGB, mx.totalGB)}/${share(mx.codeGB, mx.totalGB)}`} label="storage / acct / code" sub="composition ≈ mainnet" />
    </div>

    <div class="mt-12 rounded-2xl border border-ink-800 bg-ink-900/40 p-6">
      <div class="flex items-baseline justify-between flex-wrap gap-x-4 gap-y-1 mb-1">
        <h3 class="font-display text-2xl text-white">A 10× state is not a 10× cost</h3>
        <span class="text-xs font-mono text-ink-500">auto-plays · or pick a milestone</span>
      </div>
      <p class="text-sm text-ink-400 mb-6 max-w-3xl">The headline in one picture: as the state climbs to 10×, the costs that actually matter — trie depth and witness size — stay almost flat.</p>
      <ScalingContrast client:visible milestones={growth.milestones} proofs={proofs.series} />
    </div>

    <div class="mt-12 grid grid-cols-1 gap-12">
      <Card title="Composition: correcting the inherited state">
        <p class="text-sm text-ink-400 mb-4">Steered back to mainnet's real byte split as we grew it — so every milestone is a fair comparison.</p>
        <CompositionChart client:visible data={growth.milestones} />
        <ChartTakeaways client:visible items={[
          { to: 87, suffix: '%', label: '3.5× storage share — skewed off-mainnet', color: '#ff9900', bar: 0.87 },
          { to: 67, suffix: '%', label: '5× → 10× storage — back to mainnet', color: '#00b3ff', bar: 0.67 },
        ]} />
      </Card>

      <Card title="Total state size">
        <StateGrowthChart client:visible data={growth.milestones} />
      </Card>

      <Card title="Account-trie depth across milestones">
        <p class="text-sm text-ink-400 mb-4">Where account leaves sit in the trie, per milestone.</p>
        <TrieDepthChart client:visible levels={depth.levels} series={depth.series} pending={depth.pending} />
        <ChartTakeaways client:visible items={[
          { to: 0.84, fmt: 'dp2', prefix: '+', suffix: ' lvl', label: 'avg depth added · over a 10× state', color: '#ff9900' },
          { text: '9 → 10', label: 'the leaf peak walks just one level, 1× → 10×', color: '#34d399' },
          { text: 'log₁₆(N)', label: 'the depth law — confirmed at all 5 milestones', color: '#00b3ff' },
        ]} />
        <Detail summary="why depth barely moves — the log₁₆ law">
          <p>A 16-way trie has expected depth ≈ log₁₆(N). Mainnet → 5× deepens by <strong class="text-ink-100">+0.59 levels</strong> (7.61 → 8.20), and log₁₆(5.2×) = 0.59 — a textbook match; 5× → 10× adds only <strong class="text-ink-100">+0.25</strong> (= log₁₆(2×)). The account trie is provably <em>full</em> through depth 6 — exactly 16⁰…16⁶ branch nodes were counted — so leaves land at depth 8–9 and the whole 1× → 10× climb moves the median under one level. This is why witnesses stay small and why node counts scale linearly with leaf count, which let us predict the 7× / 10× counts before scanning them.</p>
        </Detail>
      </Card>

      <Card title="Account-trie depth vs account size">
        <p class="text-sm text-ink-400 mb-4">The leaf-weighted average account-trie depth against the exact state size — toggle the x-axis between count and bytes. The dashed line is the fitted theoretical model, extended past the measured range.</p>
        <SummaryStatsChart client:visible data={stats.accountDepth} />
        <Detail summary="is it linear? — theory & extrapolation">
          <p>Not linear — <strong class="text-ink-100">logarithmic</strong>. A uniformly-filled 16-way (hexary) trie of <span class="font-mono">N</span> leaves has expected depth ≈ <span class="font-mono">log₁₆(N)</span>. Fitting the five measured points gives <span class="font-mono text-ink-100">depth = 0.99·log₁₆(N) + 0.52</span> — slope <strong class="text-ink-100">1.00</strong> in log₁₆-space, a constant <strong class="text-ink-100">+0.48</strong> offset, and <span class="font-mono">R² = 0.99998</span>. A straight line fits far worse (<span class="font-mono">R² = 0.94</span>) and would over-predict at the top end.</p>
          <p>Because depth grows with the <em>logarithm</em> of account count, the extrapolation is almost flat: a <span class="font-mono">20×</span> state (~7.9B accounts) reaches only <strong class="text-ink-100">~8.7</strong> levels, <span class="font-mono">50×</span> ~9.0, and a <span class="font-mono">100×</span> state (~39B accounts) still only <strong class="text-ink-100">~9.3</strong> levels — under one extra level over the entire 10×→100× climb. This is the structural reason witness sizes stay bounded.</p>
        </Detail>
      </Card>

      <Card title="Storage-trie depth across milestones">
        <p class="text-sm text-ink-400 mb-4">The mirror image of account depth: mainnet tries are shallow; bloat piles into depths 9–10.</p>
        <TrieDepthChart client:visible levels={depth.storageDepth.levels} series={depth.storageDepth.series} pending={depth.storageDepth.pending} />
        <ChartTakeaways client:visible items={[
          { to: 7.81, fmt: 'dp2', suffix: ' lvl', label: 'storage avg depth at 10× (5× was 7.24)', color: '#ff9900' },
          { text: '9–10', label: 'the depths where storage-spam slots pile up', color: '#34d399' },
        ]} />
        <Detail summary="the detail">
          <p>{depth.storageDepth.note}</p>
        </Detail>
      </Card>

      <Card title="Storage-trie depth vs storage size">
        <p class="text-sm text-ink-400 mb-4">Same, for the storage trie — toggle count ⇄ bytes. The leaf-weighted average jumps at the inherited 3.5× state (its storage-spam mega-tries are already deep), then keeps climbing. Dashed line = fitted model + extrapolation.</p>
        <SummaryStatsChart client:visible data={stats.storageDepth} />
        <Detail summary="is it linear? — theory & extrapolation">
          <p>Still <strong class="text-ink-100">logarithmic</strong>, not linear (log fit <span class="font-mono">R² 0.99</span> vs linear <span class="font-mono">0.83</span>) — but with a much steeper slope: <span class="font-mono text-ink-100">~3.8 levels per 16× slots</span>, roughly <strong class="text-ink-100">4× the account trie's slope</strong>. Two effects stack on top of the log law: storage growth <em>concentrates</em> into the same ~4,097 mega-tries rather than spreading (so each added order of magnitude deepens those specific tries), and the structural-depth metric counts <em>extension</em> edges — the long shared-prefix chains that sequential storage-spam keys create — not just branch edges.</p>
          <p>Mainnet (1×) is a deliberate outlier on this curve: its storage is mostly tiny, random-key tries, so the slot-weighted depth (4.84) sits well below the bloatnet trend. Extrapolating the fitted line, a <span class="font-mono">20×</span> state lands near <strong class="text-ink-100">~8.9</strong> levels and <span class="font-mono">50×</span> near <strong class="text-ink-100">~10.2</strong> — still sub-linear, but the depth budget here is the one to watch as state grows.</p>
        </Detail>
      </Card>

      <Card title="Storage slots per contract — the long tail">
        <p class="text-sm text-ink-400 mb-4">Contracts by how many slots they own (log scale). ~87% own 1–3; a tiny tail owns 16k+ and dominates.</p>
        <SlotHistogramChart client:visible buckets={slots.buckets} series={slots.series} pending={slots.pending}
          notes={[{ coord: ['16k+', 4097], text: '~4,097 contracts\nhold the 16k+ tail', color: '#f472b6' }]} />
        <Detail summary="the detail">
          <p>{slots.note}</p>
        </Detail>
      </Card>


      <Card title="eth_getProof witness size">
        <p class="text-sm text-ink-400 mb-4">Same fixed 742-address set in every state — bars are directly comparable. Dashed line = the log₁₆ model.</p>
        <ProofComparisonChart
          client:visible
          data={proofs.series}
          pendingMults={proofs.pendingMults}
          theory={[{ mult: 1, y: 3820 }, { mult: 3.5, y: 3825 }, { mult: 5, y: 4083 }, { mult: 7, y: 4136 }, { mult: 10, y: 4192 }]}
          notes={[{ coord: ['10×', 4241], text: '+11% vs mainnet\nmaxDepth 8→9', color: '#00b3ff' }]}
          baseline={{ y: 3820, text: 'mainnet 3,820 B' }}
        />
        <Detail summary="what this means for statelessness">
          <p>Proof size tracks log₁₆ of <em>account count</em>, not the raw multiplier — which is why 3.5× (392M accounts, barely above mainnet) measures the same as mainnet, while the rebloated 5× (1.99B accounts) sits one log-step higher. {proofs.finding}</p>
          <p>A block's witness ≈ <strong class="text-ink-100">(state accesses) × (per-access witness)</strong>. The per-access term is log-bounded, so the lever that moves a block's witness budget is the <em>number of accesses</em> (and gas repricing), not individual proof size — the pre-Verkle MPT baseline a binary tree (<a href="https://eips.ethereum.org/EIPS/eip-7864" target="_blank" rel="noreferrer noopener" class="text-accent-400 hover:text-accent-300">EIP-7864</a>) is measured against.</p>
          <p class="text-xs text-ink-500">Caveat: per-proof <code>nodeLookups</code> <em>drops</em> on the bloatnets (EOA p50 112 → 72) — a flat-DB residency artifact (freshly-written state is densely packed; mainnet is fragmented by years of compaction), not a real cost reduction. Witness <em>bytes</em> are client-agnostic — EIP-1186 proofs are byte-identical across clients for the same state root — and stay the comparable size metric.</p>
        </Detail>
      </Card>

      <Card title="Snap sync — Nethermind vs Geth">
        <p class="text-sm text-ink-400 mb-4">Snap-sync wall time from a single frozen peer, by state size (lower is better). NM→NM is measured through the headline 10× (27 h 24 m); NM→Geth through 5×. 7× and the 10× Geth pairs are pending.</p>
        <ClientComparisonChart client:visible data={snap.wallTime} clients={snap.clients} unit="h" pendingMults={snap.pendingMults} theory={snap.model.points} theoryLabel={snap.model.label} />
        <div class="mt-2 flex flex-wrap items-baseline gap-x-3 gap-y-1 text-xs">
          <span class="font-mono text-ink-100">{snap.model.formula}</span>
          <span class="text-ink-500">{snap.model.fit}</span>
        </div>

        <div class="overflow-x-auto mt-6 rounded-xl border border-ink-800">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-ink-900 text-ink-300 text-left">
                <th class="px-3 py-2 font-medium">State</th>
                <th class="px-3 py-2 font-medium">Pair</th>
                <th class="px-3 py-2 font-medium text-right">Wall time</th>
                <th class="px-3 py-2 font-medium text-right">Peak RSS</th>
                <th class="px-3 py-2 font-medium text-right">Final DB</th>
                <th class="px-3 py-2 font-medium text-center">Bit-identical</th>
              </tr>
            </thead>
            <tbody class="text-ink-200">
              {snap.rows.map((r) => (
                <tr class="border-t border-ink-800">
                  <td class="px-3 py-2 font-mono text-white">{r.mult}</td>
                  <td class="px-3 py-2 font-mono">{r.pair}</td>
                  <td class="px-3 py-2 text-right tabular-nums">{r.wall}</td>
                  <td class="px-3 py-2 text-right tabular-nums">{r.rss}</td>
                  <td class="px-3 py-2 text-right tabular-nums">{r.db}</td>
                  <td class="px-3 py-2 text-center">{r.bitIdentical ? <span class="text-signal-good">✓</span> : '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <ChartTakeaways client:visible items={[
          { text: '✓ 1×–10×', label: 'every run reconstructs the root bit-for-bit', color: '#34d399' },
          { to: 9, prefix: '~', suffix: ' h', label: 'one storage trie = ⅓ of the 10× NM sync', color: '#f472b6', bar: 0.33 },
          { to: 80, prefix: '~', suffix: '%', label: 'box idle at 5× — single-peer bound, not HW', color: '#ff9900', bar: 0.80 },
        ]} />
        <Detail summary="is it linear? — theory & extrapolation">
          <p>For Nethermind, yes — snap sync is fundamentally a <strong class="text-ink-100">bulk state transfer</strong>, so wall time scales <strong class="text-ink-100">linearly with downloaded bytes</strong>: <span class="font-mono text-ink-100">t ≈ 5.3 h + 10.0·(state TB)</span>, R² 0.99 across the cross-VM 3.5×/5×/10× runs. The ~5 h intercept is fixed setup (account ranges + healing); the slope is a single-peer throughput of ~60–80 GB/h. A slightly sub-linear power law (<span class="font-mono">t ∝ TB^0.74</span>) fits marginally better still, because denser freshly-written ranges pipeline more efficiently as the state grows. Extrapolating the model, the un-run <span class="font-mono">7×</span> milestone should land near <strong class="text-ink-100">~21 h</strong> for NM → NM.</p>
          <p>Geth is the opposite — <strong class="text-ink-100">super-linear</strong>. Its effective throughput <em>collapses</em> as state grows (~78 → 47 → 19 GB/h from 1× → 3.5× → 5×) because a single peer's in-flight request cap throttles the serial mega-trie tail. That's why 5× NM → Geth took ~57 h (3.3× the NM target) on an ~80%-idle box: the ceiling is request concurrency, not bytes or hardware — so the lever is more serving peers, not a bigger machine.</p>
        </Detail>
        <Detail summary="why a 10× state isn't a 10× sync">
          <p>{snap.finding}</p>
          <p>{snap.geth5x}</p>
          <p>Snap sync parallelizes <em>across</em> contracts, but a single contract's storage trie downloads as one <strong class="text-ink-100">sequential chain of range requests</strong>. The ~4,097 mega-contracts that absorb the bulk of the slots are the non-parallelizable serial fraction — Amdahl's law — so they stall the account frontier for hours (Geth) and form the long final phase (NM). And in the 5× run the box sat <strong class="text-ink-100">~80% idle</strong> — the ceiling is single-peer request concurrency, so the highest-leverage fix is more serving peers, not faster hardware.</p>
          <p class="text-xs text-ink-500">{snap.caveat}</p>
        </Detail>

        <div class="mt-6 rounded-xl border border-signal-good/30 bg-signal-good/5 p-4 text-sm text-ink-200">
          <span class="font-mono text-signal-good text-xs uppercase tracking-wider">verified</span>
          <p class="mt-1">{proofs.crossClient}</p>
        </div>
      </Card>

      <Card title="Cross-client read latency — Geth vs Nethermind">
        <p class="text-sm text-ink-400 mb-4">JSON-RPC <strong class="text-ink-100">p99 latency</strong> per method under 50 concurrent readers at the {clients.milestone} state, 5-min duration-matched (log scale, lower is better). Geth's read tail is ~10× tighter across every method.</p>
        <RpcLatencyChart client:visible data={clients.rpcP99} clients={clients.clients} unit="ms" />
        <ChartTakeaways client:visible items={[
          { to: 27, suffix: ' ms', label: `Geth aggregate p99 (Nethermind ${clients.rpcAggregate.nethP99} ms)`, color: '#ff9900', bar: 0.1 },
          { to: 10, prefix: '~', suffix: '×', label: 'Geth read-latency tail advantage', color: '#00b3ff', bar: 1 },
          { text: '0 / 0', label: 'RPC failures — both clients, ~48k requests each', color: '#34d399' },
        ]} />

        <p class="text-sm text-ink-400 mt-8 mb-3">Execution & resource cost over the same run — <strong class="text-ink-100">opposite optima</strong>. Each bar shows how many × the winning client beats the other on that metric: Geth leans leaner (memory, disk), Nethermind leans faster (throughput, DB size).</p>
        <AdvantageChart client:visible data={clients.execution} />
        <div class="overflow-x-auto rounded-xl border border-ink-800 mt-4">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-ink-900 text-ink-300 text-left">
                <th class="px-3 py-2 font-medium">Metric</th>
                <th class="px-3 py-2 font-medium text-right">Geth</th>
                <th class="px-3 py-2 font-medium text-right">Nethermind</th>
                <th class="px-3 py-2 font-medium text-center">Leaner</th>
              </tr>
            </thead>
            <tbody class="text-ink-200">
              {clients.execution.map((r) => (
                <tr class="border-t border-ink-800">
                  <td class="px-3 py-2">{r.metric}</td>
                  <td class:list={['px-3 py-2 text-right tabular-nums font-mono', r.winner === 'geth' ? 'text-white' : 'text-ink-300']}>{r.geth}</td>
                  <td class:list={['px-3 py-2 text-right tabular-nums font-mono', r.winner === 'nethermind' ? 'text-white' : 'text-ink-300']}>{r.nethermind}</td>
                  <td class="px-3 py-2 text-center">
                    <span class:list={['text-xs font-mono px-2 py-0.5 rounded', r.winner === 'geth' ? 'bg-accent-500/15 text-accent-300' : 'bg-signal-good/15 text-signal-good']}>{r.winner === 'geth' ? 'Geth' : 'NM'}</span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <Detail summary="what the cross-client benchmark shows">
          <p>{clients.summary}</p>
          <p>{clients.proofParity}</p>
          <p class="text-xs text-ink-500">{clients.caveat}</p>
        </Detail>
        <p class="text-xs text-ink-500 mt-3">{clients.window}</p>
      </Card>
    </div>

    <h3 class="font-display text-2xl text-white mt-16 mb-4">Milestone comparison</h3>
    <div class="overflow-x-auto rounded-2xl border border-ink-800">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-ink-900 text-ink-300 text-left">
            <th class="px-4 py-3 font-medium">Milestone</th>
            <th class="px-4 py-3 font-medium text-right">Total</th>
            <th class="px-4 py-3 font-medium text-right">Accounts</th>
            <th class="px-4 py-3 font-medium text-right">Storage slots</th>
            <th class="px-4 py-3 font-medium text-right">Code</th>
            <th class="px-4 py-3 font-medium text-right">Acct depth</th>
            <th class="px-4 py-3 font-medium">Source</th>
          </tr>
        </thead>
        <tbody class="text-ink-200">
          {growth.milestones.map((m) => (
            <tr class="border-t border-ink-800 hover:bg-ink-900/40">
              <td class="px-4 py-3 font-mono text-white">{m.mult}×</td>
              <td class="px-4 py-3 text-right tabular-nums">{m.totalGB != null ? fmtTB(m.totalGB) : '—'}</td>
              <td class="px-4 py-3 text-right tabular-nums">{m.accounts != null ? (m.accounts >= 1000 ? `${(m.accounts / 1000).toFixed(2)}B` : `${m.accounts}M`) : '—'}</td>
              <td class="px-4 py-3 text-right tabular-nums">{m.storage != null ? (m.storage >= 1000 ? `${(m.storage / 1000).toFixed(2)}B` : `${m.storage}M`) : '—'}</td>
              <td class="px-4 py-3 text-right tabular-nums">{m.codeGB != null ? `${Math.round(m.codeGB)} GB` : '—'}</td>
              <td class="px-4 py-3 text-right tabular-nums">{m.accountDepth ?? '—'}</td>
              <td class="px-4 py-3">
                {m.measured
                  ? <span class="text-xs font-mono px-2 py-0.5 rounded bg-signal-good/15 text-signal-good">measured</span>
                  : <span class="text-xs font-mono px-2 py-0.5 rounded bg-ink-800 text-ink-400">pending</span>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <Detail summary="sources & notes">
      <p>{growth.note}</p>
    </Detail>
  </Section>
</BaseLayout>
