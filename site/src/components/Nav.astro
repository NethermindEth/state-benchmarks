---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
  { href: `${base}/`, label: 'Home' },
  { href: `${base}/goals`, label: 'Goals' },
  { href: `${base}/problems`, label: 'Problems' },
  { href: `${base}/design/overview`, label: 'Design' },
  { href: `${base}/results`, label: 'Results' },
  { href: `${base}/outcomes`, label: 'Outcomes' },
  { href: `${base}/timeline`, label: 'Timeline' },
  { href: `${base}/docs`, label: 'Docs' },
  { href: `${base}/about`, label: 'About' },
];
const current = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) =>
  current === href || (href.includes('/design') && current.startsWith(`${base}/design`));
---
<header class="sticky top-0 z-30 backdrop-blur-md bg-ink-950/70 border-b border-ink-800">
  <nav class="mx-auto max-w-7xl px-6 h-16 flex items-center justify-between">
    <a href={`${base}/`} class="flex items-center gap-2.5 font-display font-semibold text-white">
      <img src={`${base}/nm-icon.svg`} alt="Nethermind" width="26" height="14" class="h-3.5 w-auto" />
      <span class="text-ink-500">/</span>
      <span>state-benchmarks</span>
    </a>
    <ul class="hidden md:flex items-center gap-1 text-sm">
      {links.map((l) => {
        const href = l.href.replace(/\/$/, '');
        const active = isActive(href);
        return (
          <li>
            <a
              href={l.href}
              class:list={[
                'px-3 py-2 rounded-md transition-colors',
                active ? 'text-white bg-ink-800' : 'text-ink-300 hover:text-white hover:bg-ink-800/50',
              ]}
            >
              {l.label}
            </a>
          </li>
        );
      })}
    </ul>
    <a
      href="https://github.com/NethermindEth/state-benchmarks"
      class="text-ink-300 hover:text-white text-sm hidden sm:inline-block md:ml-0"
      rel="noreferrer noopener"
      target="_blank"
    >
      GitHub →
    </a>
    <button
      id="nav-toggle"
      type="button"
      class="md:hidden inline-flex items-center justify-center h-10 w-10 -mr-2 rounded-md text-ink-200 hover:text-white hover:bg-ink-800/50 transition-colors"
      aria-label="Open menu"
      aria-controls="mobile-menu"
      aria-expanded="false"
    >
      <svg id="nav-icon-open" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
      <svg id="nav-icon-close" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>
  </nav>

  <div id="mobile-menu" class="hidden md:hidden border-t border-ink-800 bg-ink-950/95 backdrop-blur-md">
    <ul class="px-4 py-3 space-y-1 text-sm">
      {links.map((l) => {
        const href = l.href.replace(/\/$/, '');
        const active = isActive(href);
        return (
          <li>
            <a
              href={l.href}
              class:list={[
                'block px-3 py-2.5 rounded-md transition-colors',
                active ? 'text-white bg-ink-800' : 'text-ink-300 hover:text-white hover:bg-ink-800/50',
              ]}
            >
              {l.label}
            </a>
          </li>
        );
      })}
      <li class="pt-1 mt-1 border-t border-ink-800">
        <a
          href="https://github.com/NethermindEth/state-benchmarks"
          class="block px-3 py-2.5 rounded-md text-ink-300 hover:text-white hover:bg-ink-800/50 transition-colors"
          rel="noreferrer noopener"
          target="_blank"
        >
          GitHub →
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('nav-icon-open');
  const iconClose = document.getElementById('nav-icon-close');

  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
  });
</script>
