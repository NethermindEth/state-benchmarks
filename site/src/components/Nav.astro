---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
  { href: `${base}/`, label: 'Home' },
  { href: `${base}/goals`, label: 'Goals' },
  { href: `${base}/problems`, label: 'Problems' },
  { href: `${base}/design/overview`, label: 'Design' },
  { href: `${base}/results`, label: 'Results' },
  { href: `${base}/docs`, label: 'Docs' },
  { href: `${base}/about`, label: 'About' },
];
const current = Astro.url.pathname.replace(/\/$/, '');
---
<header class="sticky top-0 z-30 backdrop-blur-md bg-ink-950/70 border-b border-ink-800">
  <nav class="mx-auto max-w-7xl px-6 h-16 flex items-center justify-between">
    <a href={`${base}/`} class="flex items-center gap-2.5 font-display font-semibold text-white">
      <img src={`${base}/nm-icon.svg`} alt="Nethermind" width="26" height="14" class="h-3.5 w-auto" />
      <span class="text-ink-500">/</span>
      <span>state-benchmarks</span>
    </a>
    <ul class="hidden md:flex items-center gap-1 text-sm">
      {links.map((l) => {
        const href = l.href.replace(/\/$/, '');
        const active = current === href || (href.includes('/design') && current.startsWith(`${base}/design`));
        return (
          <li>
            <a
              href={l.href}
              class:list={[
                'px-3 py-2 rounded-md transition-colors',
                active ? 'text-white bg-ink-800' : 'text-ink-300 hover:text-white hover:bg-ink-800/50',
              ]}
            >
              {l.label}
            </a>
          </li>
        );
      })}
    </ul>
    <a
      href="https://github.com/NethermindEth/state-benchmarks"
      class="text-ink-300 hover:text-white text-sm hidden sm:inline-block"
      rel="noreferrer noopener"
      target="_blank"
    >
      GitHub →
    </a>
  </nav>
</header>
