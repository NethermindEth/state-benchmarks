---
// Collapsible "read the detail" disclosure — keeps the deep prose available
// without making it the default reading experience.
interface Props { summary?: string }
const { summary = 'the detail' } = Astro.props;
---
<details class="group mt-4 border-t border-ink-800/70 pt-3">
  <summary class="flex items-center gap-1.5 cursor-pointer list-none [&::-webkit-details-marker]:hidden text-xs font-mono uppercase tracking-wider text-ink-500 hover:text-ink-300 transition-colors">
    <svg class="size-3 transition-transform group-open:rotate-90" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M4.5 3l3 3-3 3" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    {summary}
  </summary>
  <div class="mt-3 text-sm text-ink-400 leading-relaxed space-y-2">
    <slot />
  </div>
</details>
