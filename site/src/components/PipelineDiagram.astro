---
// Closed-loop bloating pipeline, rendered as styled boxes + flow arrows.
const nodes = [
  { id: 'controller', label: 'Controller', sub: 'verb scoring · projected gradient', tone: 'accent' },
  { id: 'nm', label: 'Nethermind', sub: 'testing_commitBlockV1 + StateDiffsWriter', tone: 'plain' },
  { id: 'sidecar', label: 'Sidecar', sub: 'RocksDB secondary · statecomp_*', tone: 'good' },
];
---
<div class="not-prose my-8 rounded-2xl border border-ink-800 bg-ink-900/40 p-6">
  <div class="flex flex-col md:flex-row items-stretch gap-3 md:gap-0">
    {nodes.map((n, i) => (
      <>
        <div class:list={[
          'flex-1 rounded-xl border p-4 text-center',
          n.tone === 'accent' && 'border-accent-500/50 bg-accent-500/5',
          n.tone === 'good' && 'border-signal-good/40 bg-signal-good/5',
          n.tone === 'plain' && 'border-ink-700 bg-ink-900/60',
        ]}>
          <div class="font-display text-white">{n.label}</div>
          <div class="mt-1 text-xs font-mono text-ink-400">{n.sub}</div>
        </div>
        {i < nodes.length - 1 && (
          <div class="flex items-center justify-center px-2 text-accent-400 shrink-0">
            <span class="hidden md:inline">→</span>
            <span class="md:hidden">↓</span>
          </div>
        )}
      </>
    ))}
  </div>
  <div class="mt-4 flex items-center gap-3 rounded-lg border border-ink-800 bg-ink-950/60 px-4 py-3">
    <span class="text-signal-good">◀</span>
    <div class="text-sm text-ink-300">
      <span class="font-mono text-signal-good">feedback</span> — the sidecar reports the live composition over
      <code class="text-accent-400">statecomp_lite</code>; the controller reads it each tick and picks the next verb mix.
      Every committed block is also written to <code class="text-accent-400">payloads.rlp</code> for replay.
    </div>
  </div>
</div>
