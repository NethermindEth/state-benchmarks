---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const items = [
  { href: `${base}/design/overview`,     label: '1 · System overview' },
  { href: `${base}/design/bloating`,     label: '2 · Bloating methods' },
  { href: `${base}/design/metrics`,      label: '3 · Metrics & math'   },
  { href: `${base}/design/orchestrator`, label: '4 · Feedback loop'    },
];
const current = Astro.url.pathname.replace(/\/$/, '');
---
<nav class="text-sm">
  <div class="uppercase tracking-wide text-xs text-ink-400 mb-3">Design</div>
  <ul class="space-y-1 border-l border-ink-800">
    {items.map((i) => {
      const href = i.href.replace(/\/$/, '');
      const active = current === href;
      return (
        <li>
          <a
            href={i.href}
            class:list={[
              '-ml-px block border-l-2 pl-4 py-1.5 transition-colors',
              active
                ? 'border-accent-500 text-white'
                : 'border-transparent text-ink-300 hover:text-white hover:border-ink-600',
            ]}
          >
            {i.label}
          </a>
        </li>
      );
    })}
  </ul>
</nav>
